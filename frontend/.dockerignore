# Keep the build context small and the image reproducible.
#
# Without this, `COPY . .` in the Dockerfile pulls node_modules (hundreds of MB,
# host platform specific) into the builder layer and busts its cache on every
# install.

node_modules
dist
.git
.gitignore

# Local env files — never baked into an image.
.env
.env.*
!.env.example

# Editor and OS noise.
.vscode
.idea
.DS_Store
*.swp

# Test and coverage output.
coverage
*.log
npm-debug.log*
