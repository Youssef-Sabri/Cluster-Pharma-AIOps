# ---------------------------------------------------------------------------
# ClusterOps — environment template. Copy to `.env` and adjust.
# Every dataset produced by this project is 100% synthetic and exists purely
# for demonstration purposes.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Async (asyncpg) URL used by the application at runtime.
DATABASE_URL=postgresql+asyncpg://cluster:cluster@localhost:5432/clusterops
# Sync (psycopg2) URL — required by Alembic migrations and the test bootstrap.
SYNC_DATABASE_URL=postgresql://cluster:cluster@localhost:5432/clusterops
# Dedicated database for the automated test-suite.
TEST_DATABASE_URL=postgresql+asyncpg://cluster:cluster@localhost:5432/clusterops_test
TEST_SYNC_DATABASE_URL=postgresql://cluster:cluster@localhost:5432/clusterops_test
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Experiment tracking --------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=clusterops-demand-forecast
MLFLOW_MODEL_NAME=lgbm-demand-forecast
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Third party ----------------------------------------------------------
# Free-tier Gemini key, used only as a re-ranker for ambiguous order tokens.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Orchestration --------------------------------------------------------
PREFECT_API_URL=http://localhost:4200/api

# --- Application ----------------------------------------------------------
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# --- ML / safety thresholds ----------------------------------------------
# rapidfuzz score above which a token is accepted without an LLM re-rank.
CONFIDENCE_THRESHOLD=0.70
# Below this final confidence an item is routed to the human review queue.
REVIEW_CONFIDENCE_THRESHOLD=0.50
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_ALERT=0.20
# Challenger must beat production MAE by this fraction to be promoted (3% rule).
PROMOTION_GATE_IMPROVEMENT=0.03

# --- Synthetic data generator --------------------------------------------
DATA_RANDOM_SEED=42
DATA_GENERATION_DAYS=180